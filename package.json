{
  "name": "flow-of-money",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run data:validate && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data:validate": "node scripts/validate-data.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:types": "wrangler types --strict-vars=false --include-runtime=false",
    "worker:check": "tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev",
    "worker:migrate:local": "wrangler d1 migrations apply DB --local",
    "worker:deploy": "npm run worker:build && npm run worker:check && wrangler deploy",
    "worker:build": "npm run build && node scripts/prepare-worker-assets.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.18.1",
    "@clerk/react": "^6.16.1",
    "@deck.gl/core": "^9.1.14",
    "@deck.gl/layers": "^9.1.14",
    "@deck.gl/mapbox": "^9.1.14",
    "@tanstack/react-query": "^5.83.0",
    "i18next": "^25.3.2",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.1",
    "react-map-gl": "^8.0.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "jose": "^6.2.12",
    "jsdom": "^26.1.0",
    "miniflare": "^5.20260921.0-alpha",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.136.0"
  }
}
